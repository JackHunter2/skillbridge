{
  "services": {
    "client": {
      "root": "client/"
    },
    "server": {
      "root": "server/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      { "source": "/api/(.*)", "destination": "/api/index.js" },
      { "source": "/(.*)", "destination": "/index.html" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
