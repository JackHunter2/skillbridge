{
  "services": {
    "client": {
      "root": "client/"
    },
    "server": {
      "root": "server/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
